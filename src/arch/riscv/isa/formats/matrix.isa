def format MatrixConfIOp(code, *flags) {{
    imm_code = """
                uimm = MIMM10;
               """
    iop = InstObjParams(name, Name, 'RiscvMatrixConfIOp', {'code': code, 'imm_code': imm_code}, flags)
    header_output = MatrixConfIDeclare.subst(iop)
    decoder_output = MatrixConfIConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = MatrixExecute.subst(iop)
}};

def format MatrixConfOp(code, *flags) {{
    regs = ['srcRegIdx(0)']
    iop = InstObjParams(name, Name, 'RiscvMatrixConfOp', {'code': code, 'regs': ','.join(regs)}, flags)
    header_output = MatrixConfDeclare.subst(iop)
    decoder_output = MatrixConfConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = MatrixExecute.subst(iop)
}};

