def template MatrixMoveConstructor{{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst,  %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        if (mfunct4() == 2) {
            setSrcRegIdx(_numSrcRegs++, intRegClass[mrs1()]);
            setDestRegIdx(_numDestRegs++, intRegClass[mrd()]);
        }
        else if (mfunct4() == 3) {
            setSrcRegIdx(_numSrcRegs++, intRegClass[mrs1()]);
            setSrcRegIdx(_numSrcRegs++, intRegClass[mrs2()]);
        }
        else {

        }
    }
}};

