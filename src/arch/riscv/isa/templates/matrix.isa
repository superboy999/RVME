// Basic instruction class execute method template.
def template MatrixExecute{{
    Fault
    %(class_name)s::execute(
        ExecContext *xc, trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;
        %(code)s;
        %(op_wb)s;
        panic("Matrix instruction had it's execute() called!");
        return NoFault;
    }
}};